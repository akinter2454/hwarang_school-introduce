{
  "rules": {
    ".read": false,
    ".write": false,

    "spaces": {
      ".read": "auth != null",

      "$spaceId": {
        ".write": "auth != null",

        ".validate": "!newData.exists() || (newData.hasChildren(['id','floor','name','oneLineIntro','description','specialPoint','usageGuide','rules','author','images','status','createdAt','updatedAt','likes']) && newData.child('id').val() == $spaceId && newData.child('floor').isNumber() && newData.child('floor').val() >= 1 && newData.child('floor').val() <= 5 && newData.child('name').isString() && newData.child('name').val().length <= 100 && newData.child('likes').isNumber() && newData.child('likes').val() >= 0)",

        "images": {
          "0": { ".validate": "newData.isString() && newData.val().length <= 260000" },
          "1": { ".validate": "newData.isString() && newData.val().length <= 260000" },
          "2": { ".validate": "newData.isString() && newData.val().length <= 260000" },
          "3": { ".validate": "newData.isString() && newData.val().length <= 260000" },
          "4": { ".validate": "newData.isString() && newData.val().length <= 260000" },
          "5": { ".validate": "newData.isString() && newData.val().length <= 260000" },
          "6": { ".validate": "newData.isString() && newData.val().length <= 260000" },
          "7": { ".validate": "newData.isString() && newData.val().length <= 260000" },
          "8": { ".validate": "newData.isString() && newData.val().length <= 260000" },
          "9": { ".validate": "newData.isString() && newData.val().length <= 260000" },
          "$other": { ".validate": false }
        }
      }
    },

    "comments": {
      ".read": "auth != null",

      "$commentId": {
        ".write": "auth != null",

        ".validate": "!newData.exists() || (newData.hasChildren(['id','spaceId','authorName','authorGradeClass','avatar','content','createdAt','likes']) && newData.child('id').val() == $commentId && newData.child('content').isString() && newData.child('content').val().length <= 1000 && newData.child('likes').isNumber() && newData.child('likes').val() >= 0)"
      }
    },

    "meta": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
